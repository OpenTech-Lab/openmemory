#!/usr/bin/env bash
# mem — OpenMemory CLI
# Requires: curl, jq
# Config:   OPENMEMORY_URL (default: http://localhost:18080)

set -euo pipefail

BASE_URL="${OPENMEMORY_URL:-http://localhost:18080}"
CMD="${1:-}"

# Resolve the API token: explicit env var, then the persisted token file
# written by the server on first run (mirrors resolve_api_token() in main.rs).
API_TOKEN="${OPENMEMORY_API_TOKEN:-}"
if [ -z "$API_TOKEN" ] && [ -f "$HOME/.openmemory/api_token" ]; then
    API_TOKEN=$(tr -d '[:space:]' < "$HOME/.openmemory/api_token")
fi

_require_jq() {
    if ! command -v jq >/dev/null 2>&1; then
        echo "error: jq is required (brew install jq / apt install jq)" >&2
        exit 1
    fi
}

_post() {
    local payload="$1"
    local http_code body response
    local auth_args=()
    [ -n "$API_TOKEN" ] && auth_args=(-H "Authorization: Bearer $API_TOKEN")
    # Sentinel __STATUS__ is safe for controlled JSON API responses (dev CLI only)
    response=$(curl -s -w "\n__STATUS__%{http_code}" \
        -X POST "$BASE_URL/mcp" \
        -H 'content-type: application/json' \
        "${auth_args[@]}" \
        -d "$payload")
    http_code=$(printf '%s' "$response" | tail -1 | sed 's/__STATUS__//')
    body=$(printf '%s' "$response" | sed '$d' | sed 's/__STATUS__[0-9]*//')

    if [ "${http_code:-0}" -ge 400 ] 2>/dev/null; then
        local err
        err=$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)
        if [ -n "$err" ]; then
            echo "error: $err" >&2
        else
            echo "error (HTTP $http_code): $body" >&2
        fi
        exit 1
    fi

    printf '%s' "$body" | jq . 2>/dev/null || printf '%s\n' "$body"
}

# Like _post, but for suggestion-only calls that must never block or fail the
# caller's actual create: on any error (including LLM not configured) it
# prints a warning to stderr and returns success with empty stdout, instead
# of exiting the script.
_post_optional() {
    local payload="$1"
    local http_code body response
    local auth_args=()
    [ -n "$API_TOKEN" ] && auth_args=(-H "Authorization: Bearer $API_TOKEN")
    response=$(curl -s -w "\n__STATUS__%{http_code}" \
        -X POST "$BASE_URL/mcp" \
        -H 'content-type: application/json' \
        "${auth_args[@]}" \
        -d "$payload") || { echo "warning: autofill request failed (network error)" >&2; return 0; }
    http_code=$(printf '%s' "$response" | tail -1 | sed 's/__STATUS__//')
    body=$(printf '%s' "$response" | sed '$d' | sed 's/__STATUS__[0-9]*//')

    if [ "${http_code:-0}" -ge 400 ] 2>/dev/null; then
        local err
        err=$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)
        echo "warning: autofill suggestion unavailable${err:+ ($err)}" >&2
        return 0
    fi

    printf '%s' "$body"
}

_get() {
    local path="$1"
    local http_code body response
    local auth_args=()
    [ -n "$API_TOKEN" ] && auth_args=(-H "Authorization: Bearer $API_TOKEN")
    response=$(curl -s -w "\n__STATUS__%{http_code}" \
        -X GET "$BASE_URL$path" \
        -H 'accept: application/json' \
        "${auth_args[@]}")
    http_code=$(printf '%s' "$response" | tail -1 | sed 's/__STATUS__//')
    body=$(printf '%s' "$response" | sed '$d' | sed 's/__STATUS__[0-9]*//')

    if [ "${http_code:-0}" -ge 400 ] 2>/dev/null; then
        local err
        err=$(printf '%s' "$body" | jq -r '.error // empty' 2>/dev/null)
        if [ -n "$err" ]; then
            echo "error: $err" >&2
        else
            echo "error (HTTP $http_code): $body" >&2
        fi
        exit 1
    fi

    printf '%s' "$body" | jq . 2>/dev/null || printf '%s\n' "$body"
}

_usage() {
    cat >&2 <<'EOF'
usage: mem <command> [args]

Memory commands:
  save <content> [--importance 0.5] [--tags tag1,tag2] [--summary TEXT] [--auto]
  search <query> [--limit 5]
  list [--limit 20]
  get <uuid>
  delete <uuid>

AI autofill (suggestion-only; shares the LLM key configured for graph
extraction — set it via LLM Settings in the web UI):
  autofill memory <content>    suggest summary/tags/importance, don't save
  autofill task <content>      suggest description/labels/priority, don't save
  autofill resource <content>  suggest description/tags, don't save
  save ... --auto              fill only the fields you didn't pass explicitly
  resource-add ... --auto      same, for resource-add

Environment parameter commands:
  env-set <key> <value> [--secret] [--description TEXT]
  env-rename <old-key> <new-key> [--value VALUE] [--secret|--normal] [--description TEXT]
  env-get <key>           (normal params only; secret params return an error)
  env-list
  env-delete <key>

Resource catalog commands (local paths + website URLs):
  resource-list [--kind path|url] [--query TEXT] [--tags a,b]
  resource-tags
  resource-get <id-or-name>
  resource-add <name> --kind path|url --location <loc> [--description TEXT] [--tags a,b] [--env-keys a,b] [--auto]
  resource-update <uuid> [--name N] [--kind path|url] [--location L] [--description TEXT] [--tags a,b] [--env-keys a,b] [--clear-env-keys] [--clear-description]
  resource-delete <uuid>
  # Env-declared roots (also appear in resource-list):
  #   mem env-set RESOURCE_PATH.<slug> /abs/path --description "..."
  #   mem env-set RESOURCE_URL.<slug> https://... --description "..."
  #   mem env-set RESOURCE_AUTH.<slug> CREDENTIAL_KEY_NAME   # links env_param_key

Lessons-learned commands (read-only; writes go through the agent via MCP):
  lessons [--project <uuid>] [--query TEXT] [--limit N]

Session watcher commands (Mode 3):
  sessions [--limit 50]                list recorded sessions
  sessions <uuid>                      show session details
  sessions messages <uuid> [--limit 200] [--after N]  list messages for a session

Config:
  OPENMEMORY_URL  (default: http://localhost:18080)
EOF
    exit 1
}

case "$CMD" in

  save)
    _require_jq
    shift
    CONTENT="${1:?error: content required — usage: mem save <content> [--importance N] [--tags t1,t2] [--summary TEXT] [--auto]}"
    shift
    # Sentinels: only a field the user explicitly passed (or --auto fills)
    # gets serialized into the payload below. Anything left unset is omitted
    # entirely so the server's own defaults (importance 0.5, tags []) apply —
    # this is what lets --auto tell "omitted" apart from "explicitly 0.5".
    HAVE_IMPORTANCE=false
    HAVE_TAGS=false
    HAVE_SUMMARY=false
    AUTO=false
    IMPORTANCE=""
    TAGS="[]"
    SUMMARY=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --importance) IMPORTANCE="$2"; HAVE_IMPORTANCE=true; shift 2 ;;
            --tags)
                TAGS=$(printf '%s' "$2" | tr ',' '\n' | jq -R . | jq -sc .)
                HAVE_TAGS=true
                shift 2 ;;
            --summary)
                SUMMARY="$2"
                HAVE_SUMMARY=true
                shift 2 ;;
            --auto) AUTO=true; shift ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done

    if [ "$AUTO" = "true" ] && { [ "$HAVE_IMPORTANCE" = "false" ] || [ "$HAVE_TAGS" = "false" ] || [ "$HAVE_SUMMARY" = "false" ]; }; then
        AUTOFILL_PAYLOAD=$(jq -n --arg content "$CONTENT" '{type:"ai.autofill",kind:"memory",content:$content}')
        SUGGESTION=$(_post_optional "$AUTOFILL_PAYLOAD" | jq -c '.suggestion // empty' 2>/dev/null || true)
        if [ -n "${SUGGESTION:-}" ] && [ "$SUGGESTION" != "null" ]; then
            if [ "$HAVE_IMPORTANCE" = "false" ]; then
                V=$(printf '%s' "$SUGGESTION" | jq -r '.importance // empty')
                [ -n "$V" ] && { IMPORTANCE="$V"; HAVE_IMPORTANCE=true; }
            fi
            if [ "$HAVE_TAGS" = "false" ]; then
                V=$(printf '%s' "$SUGGESTION" | jq -c '.tags // empty')
                [ -n "$V" ] && [ "$V" != "[]" ] && { TAGS="$V"; HAVE_TAGS=true; }
            fi
            if [ "$HAVE_SUMMARY" = "false" ]; then
                V=$(printf '%s' "$SUGGESTION" | jq -r '.summary // empty')
                [ -n "$V" ] && { SUMMARY="$V"; HAVE_SUMMARY=true; }
            fi
        fi
    fi

    PAYLOAD=$(jq -n --arg content "$CONTENT" '{type:"memory.save",content:$content}')
    [ "$HAVE_IMPORTANCE" = "true" ] && PAYLOAD=$(printf '%s' "$PAYLOAD" | jq --argjson v "$IMPORTANCE" '. + {importance:$v}')
    [ "$HAVE_TAGS" = "true" ] && PAYLOAD=$(printf '%s' "$PAYLOAD" | jq --argjson v "$TAGS" '. + {tags:$v}')
    [ "$HAVE_SUMMARY" = "true" ] && PAYLOAD=$(printf '%s' "$PAYLOAD" | jq --arg v "$SUMMARY" '. + {summary:$v}')
    _post "$PAYLOAD"
    ;;

  search)
    _require_jq
    shift
    QUERY="${1:?error: query required — usage: mem search <query> [--limit N]}"
    shift
    LIMIT="5"
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit) LIMIT="$2"; shift 2 ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    PAYLOAD=$(jq -n --arg q "$QUERY" --argjson l "$LIMIT" \
        '{type:"memory.search",query:$q,limit:$l}')
    _post "$PAYLOAD"
    ;;

  list)
    _require_jq
    shift
    LIMIT="20"
    while [ $# -gt 0 ]; do
        case "$1" in
            --limit) LIMIT="$2"; shift 2 ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    PAYLOAD=$(jq -n --argjson l "$LIMIT" '{type:"memory.list",limit:$l}')
    _post "$PAYLOAD"
    ;;

  get)
    _require_jq
    shift
    ID="${1:?error: uuid required — usage: mem get <uuid>}"
    PAYLOAD=$(jq -n --arg id "$ID" '{type:"memory.get",id:$id}')
    _post "$PAYLOAD"
    ;;

  delete)
    _require_jq
    shift
    ID="${1:?error: uuid required — usage: mem delete <uuid>}"
    PAYLOAD=$(jq -n --arg id "$ID" '{type:"memory.delete",id:$id}')
    _post "$PAYLOAD"
    ;;

  env-set)
    _require_jq
    shift
    ENV_KEY="${1:?error: key required — usage: mem env-set <key> <value> [--secret] [--description TEXT]}"
    shift
    ENV_VALUE="${1:?error: value required — usage: mem env-set <key> <value> [--secret] [--description TEXT]}"
    case "$ENV_VALUE" in
        --*) echo "error: value argument looks like a flag ('$ENV_VALUE') — did you forget the value?" >&2; exit 1 ;;
    esac
    shift
    IS_SECRET="false"
    ENV_DESC="null"
    while [ $# -gt 0 ]; do
        case "$1" in
            --secret) IS_SECRET="true"; shift ;;
            --description)
                ENV_DESC=$(jq -n --arg v "$2" '$v')
                shift 2 ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    PAYLOAD=$(jq -n \
        --arg key "$ENV_KEY" \
        --arg value "$ENV_VALUE" \
        --argjson is_secret "$IS_SECRET" \
        --argjson description "$ENV_DESC" \
        '{type:"env.set",key:$key,value:$value,is_secret:$is_secret,description:$description}')
    _post "$PAYLOAD"
    ;;

  env-rename)
    _require_jq
    shift
    OLD_ENV_KEY="${1:?error: old key required — usage: mem env-rename <old-key> <new-key> [--value VALUE] [--secret|--normal] [--description TEXT]}"
    NEW_ENV_KEY="${2:?error: new key required — usage: mem env-rename <old-key> <new-key> [--value VALUE] [--secret|--normal] [--description TEXT]}"
    shift 2
    HAVE_ENV_VALUE=false
    ENV_VALUE=""
    HAVE_IS_SECRET=false
    IS_SECRET="false"
    ENV_DESC="null"
    while [ $# -gt 0 ]; do
        case "$1" in
            --value)
                ENV_VALUE="$2"
                HAVE_ENV_VALUE=true
                shift 2
                ;;
            --secret)
                IS_SECRET="true"
                HAVE_IS_SECRET=true
                shift
                ;;
            --normal)
                IS_SECRET="false"
                HAVE_IS_SECRET=true
                shift
                ;;
            --description)
                ENV_DESC=$(jq -n --arg v "$2" '$v')
                shift 2
                ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    PAYLOAD=$(jq -n \
        --arg old_key "$OLD_ENV_KEY" \
        --arg new_key "$NEW_ENV_KEY" \
        --arg value "$ENV_VALUE" \
        --argjson is_secret "$IS_SECRET" \
        --argjson description "$ENV_DESC" \
        --argjson have_value "$HAVE_ENV_VALUE" \
        --argjson have_is_secret "$HAVE_IS_SECRET" \
        '{type:"env.rename",old_key:$old_key,new_key:$new_key}
         + (if $have_value then {value:$value} else {} end)
         + (if $have_is_secret then {is_secret:$is_secret} else {} end)
         + (if $description != null then {description:$description} else {} end)')
    _post "$PAYLOAD"
    ;;

  env-get)
    _require_jq
    shift
    ENV_KEY="${1:?error: key required — usage: mem env-get <key>}"
    PAYLOAD=$(jq -n --arg key "$ENV_KEY" '{type:"env.get",key:$key}')
    _post "$PAYLOAD"
    ;;

  env-list)
    _require_jq
    shift
    _post '{"type":"env.list"}'
    ;;

  env-delete)
    _require_jq
    shift
    ENV_KEY="${1:?error: key required — usage: mem env-delete <key>}"
    PAYLOAD=$(jq -n --arg key "$ENV_KEY" '{type:"env.delete",key:$key}')
    _post "$PAYLOAD"
    ;;

  resource-list)
    _require_jq
    shift
    KIND="null"
    QUERY="null"
    TAGS="null"
    while [ $# -gt 0 ]; do
        case "$1" in
            --kind) KIND=$(jq -n --arg v "$2" '$v'); shift 2 ;;
            --query) QUERY=$(jq -n --arg v "$2" '$v'); shift 2 ;;
            --tags) TAGS=$(printf '%s' "$2" | tr ',' '\n' | jq -R . | jq -sc .); shift 2 ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    PAYLOAD=$(jq -n \
        --argjson kind "$KIND" \
        --argjson query "$QUERY" \
        --argjson tags "$TAGS" \
        '{type:"resource.list",kind:$kind,query:$query,tags:$tags}')
    _post "$PAYLOAD"
    ;;

  resource-tags)
    _require_jq
    shift
    _post '{"type":"resource.tags"}'
    ;;

  resource-get)
    _require_jq
    shift
    ID_OR_NAME="${1:?error: id or name required — usage: mem resource-get <id-or-name>}"
    PAYLOAD=$(jq -n --arg id "$ID_OR_NAME" '{type:"resource.get",id_or_name:$id}')
    _post "$PAYLOAD"
    ;;

  resource-add)
    _require_jq
    shift
    NAME="${1:?error: name required — usage: mem resource-add <name> --kind path|url --location <loc>}"
    shift
    KIND=""
    LOCATION=""
    HAVE_DESC=false
    DESC=""
    HAVE_TAGS=false
    TAGS="[]"
    ENV_KEYS="[]"
    AUTO=false
    while [ $# -gt 0 ]; do
        case "$1" in
            --kind) KIND="$2"; shift 2 ;;
            --location) LOCATION="$2"; shift 2 ;;
            --description) DESC="$2"; HAVE_DESC=true; shift 2 ;;
            --tags)
                TAGS=$(printf '%s' "$2" | tr ',' '\n' | jq -R . | jq -sc .)
                HAVE_TAGS=true
                shift 2 ;;
            --env-keys)
                ENV_KEYS=$(printf '%s' "$2" | tr ',' '\n' | jq -R . | jq -sc .)
                shift 2 ;;
            --auto) AUTO=true; shift ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    if [ -z "$KIND" ] || [ -z "$LOCATION" ]; then
        echo "error: --kind and --location are required" >&2
        exit 1
    fi

    if [ "$AUTO" = "true" ] && { [ "$HAVE_DESC" = "false" ] || [ "$HAVE_TAGS" = "false" ]; }; then
        AF_CONTENT="name: ${NAME}, location: ${LOCATION}"
        [ "$HAVE_DESC" = "true" ] && AF_CONTENT="${AF_CONTENT}, description: ${DESC}"
        AUTOFILL_PAYLOAD=$(jq -n --arg content "$AF_CONTENT" '{type:"ai.autofill",kind:"resource",content:$content}')
        SUGGESTION=$(_post_optional "$AUTOFILL_PAYLOAD" | jq -c '.suggestion // empty' 2>/dev/null || true)
        if [ -n "${SUGGESTION:-}" ] && [ "$SUGGESTION" != "null" ]; then
            if [ "$HAVE_DESC" = "false" ]; then
                V=$(printf '%s' "$SUGGESTION" | jq -r '.description // empty')
                [ -n "$V" ] && { DESC="$V"; HAVE_DESC=true; }
            fi
            if [ "$HAVE_TAGS" = "false" ]; then
                V=$(printf '%s' "$SUGGESTION" | jq -c '.tags // empty')
                [ -n "$V" ] && [ "$V" != "[]" ] && { TAGS="$V"; HAVE_TAGS=true; }
            fi
        fi
    fi

    DESC_JSON="null"
    [ "$HAVE_DESC" = "true" ] && DESC_JSON=$(jq -n --arg v "$DESC" '$v')
    PAYLOAD=$(jq -n \
        --arg name "$NAME" \
        --arg kind "$KIND" \
        --arg location "$LOCATION" \
        --argjson description "$DESC_JSON" \
        --argjson tags "$TAGS" \
        --argjson env_param_keys "$ENV_KEYS" \
        '{type:"resource.add",name:$name,kind:$kind,location:$location,description:$description,tags:$tags,env_param_keys:$env_param_keys}')
    _post "$PAYLOAD"
    ;;

  resource-update)
    _require_jq
    shift
    ID="${1:?error: uuid required — usage: mem resource-update <uuid> [...]}"
    shift
    # Build patch object field by field
    PATCH=$(jq -n --arg id "$ID" '{type:"resource.update",id:$id}')
    while [ $# -gt 0 ]; do
        case "$1" in
            --name)
                PATCH=$(printf '%s' "$PATCH" | jq --arg v "$2" '. + {name:$v}')
                shift 2 ;;
            --kind)
                PATCH=$(printf '%s' "$PATCH" | jq --arg v "$2" '. + {kind:$v}')
                shift 2 ;;
            --location)
                PATCH=$(printf '%s' "$PATCH" | jq --arg v "$2" '. + {location:$v}')
                shift 2 ;;
            --description)
                PATCH=$(printf '%s' "$PATCH" | jq --arg v "$2" '. + {description:$v}')
                shift 2 ;;
            --tags)
                T=$(printf '%s' "$2" | tr ',' '\n' | jq -R . | jq -sc .)
                PATCH=$(printf '%s' "$PATCH" | jq --argjson t "$T" '. + {tags:$t}')
                shift 2 ;;
            --env-keys)
                E=$(printf '%s' "$2" | tr ',' '\n' | jq -R . | jq -sc .)
                PATCH=$(printf '%s' "$PATCH" | jq --argjson e "$E" '. + {env_param_keys:$e}')
                shift 2 ;;
            --clear-env-keys)
                PATCH=$(printf '%s' "$PATCH" | jq '. + {env_param_keys:[]}')
                shift ;;
            --clear-description)
                PATCH=$(printf '%s' "$PATCH" | jq '. + {description:null}')
                shift ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    _post "$PATCH"
    ;;

  resource-delete)
    _require_jq
    shift
    ID="${1:?error: uuid required — usage: mem resource-delete <uuid>}"
    PAYLOAD=$(jq -n --arg id "$ID" '{type:"resource.delete",id:$id}')
    _post "$PAYLOAD"
    ;;

  autofill)
    _require_jq
    shift
    KIND="${1:?error: kind required — usage: mem autofill <memory|task|resource> <content>}"
    shift
    case "$KIND" in
        memory|task|resource) ;;
        *) echo "error: kind must be one of: memory, task, resource" >&2; exit 1 ;;
    esac
    CONTENT="${1:?error: content required — usage: mem autofill <memory|task|resource> <content>}"
    PAYLOAD=$(jq -n --arg kind "$KIND" --arg content "$CONTENT" '{type:"ai.autofill",kind:$kind,content:$content}')
    _post "$PAYLOAD"
    ;;

  lessons)
    _require_jq
    shift
    PROJECT=""
    QUERY=""
    LIMIT=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --project) PROJECT="$2"; shift 2 ;;
            --query) QUERY="$2"; shift 2 ;;
            --limit) LIMIT="$2"; shift 2 ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
        esac
    done
    PARAMS=""
    _add_param() {
        local key="$1" value="$2"
        [ -z "$value" ] && return
        local enc
        enc=$(jq -rn --arg v "$value" '$v|@uri')
        PARAMS="${PARAMS}${PARAMS:+&}${key}=${enc}"
    }
    _add_param "query" "$QUERY"
    _add_param "limit" "$LIMIT"
    if [ -n "$PROJECT" ]; then
        _get "/projects/${PROJECT}/lessons${PARAMS:+?$PARAMS}"
    else
        _get "/lessons${PARAMS:+?$PARAMS}"
    fi
    ;;

  help|--help|-h|"")
    _usage
    ;;

  sessions)
    _require_jq
    shift
    SUBCMD="${1:-}"
    case "$SUBCMD" in
      messages)
        shift
        SID="${1:?error: session uuid required — usage: mem sessions messages <uuid>}"
        shift
        LIMIT="200"
        AFTER=""
        while [ $# -gt 0 ]; do
          case "$1" in
            --limit) LIMIT="$2"; shift 2 ;;
            --after) AFTER="$2"; shift 2 ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
          esac
        done
        QUERY="/sessions/${SID}/messages?limit=${LIMIT}"
        [ -n "$AFTER" ] && QUERY="${QUERY}&after=${AFTER}"
        _get "$QUERY"
        ;;
      ""|-*|--limit)
        LIMIT="50"
        while [ $# -gt 0 ]; do
          case "$1" in
            --limit) LIMIT="$2"; shift 2 ;;
            *) echo "error: unknown flag $1" >&2; exit 1 ;;
          esac
        done
        _get "/sessions?limit=${LIMIT}"
        ;;
      *)
        _get "/sessions/${SUBCMD}"
        ;;
    esac
    ;;

  *)
    echo "error: unknown command '$CMD'" >&2
    _usage
    ;;

esac
