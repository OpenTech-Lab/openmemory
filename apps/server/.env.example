# Server port
OPENMEMORY_PORT=18080

# PostgreSQL - Index store (metadata, importance, tags)
DATABASE_URL=postgres://openmemory:openmemory@localhost:5432/openmemory

# OpenSearch - Document store (full content, searchable text)
OPENSEARCH_URL=http://localhost:9201

# Redis - Cache (optional, for search result caching)
REDIS_URL=redis://localhost:6399

# FalkorDB - Graph memory (optional, for relationship traversal)
FALKORDB_URL=redis://localhost:6380

# Encryption key for env_params values at rest. REQUIRED — the server refuses to
# start without it (set OPENMEMORY_ALLOW_INSECURE_DEV_KEY=1 to opt into the
# well-known dev key for CI/tests only). Generate a real value with:
#   openssl rand -base64 48
OPENMEMORY_SECRET_KEY=

# Bearer token required for reading secret env params (change in production!)
OPENMEMORY_API_TOKEN=dev-token-change-me
